{
  "version": 1,
  "description": "React Native / Expo library -> native replacement lookup. Used by tools/rn-inventory.mjs and rendered into guidelines/09-rn-to-native-mapping.md (node tools/rn-inventory.mjs --print-map). 'match' is an exact package name or a prefix ending in '*'. risk: high = affects data, identity, money or store continuity.",
  "entries": [
    {
      "match": "expo-router",
      "category": "navigation",
      "risk": "medium",
      "ios": "NavigationStack(path:) + route enum; TabView",
      "android": "Navigation 3 (or type-safe Navigation Compose)",
      "notes": "File tree under app/ is the route table; +api routes are server-only"
    },
    {
      "match": "@react-navigation/*",
      "category": "navigation",
      "risk": "medium",
      "ios": "NavigationStack / TabView / sheets",
      "android": "Navigation 3 / Navigation Compose; NavigationBar; ModalNavigationDrawer",
      "notes": "The linking config is the deep-link table: copy it to contracts/deeplinks.md"
    },
    {
      "match": "react-native-screens",
      "category": "navigation",
      "risk": "low",
      "ios": "built in",
      "android": "built in",
      "notes": "Infrastructure only"
    },
    {
      "match": "react-native-safe-area-context",
      "category": "layout",
      "risk": "low",
      "ios": "SwiftUI safe areas (built in)",
      "android": "WindowInsets + enableEdgeToEdge()",
      "notes": ""
    },
    {
      "match": "react-native-keyboard-controller",
      "category": "layout",
      "risk": "low",
      "ios": "Built-in keyboard avoidance; scrollDismissesKeyboard",
      "android": "imePadding() / WindowInsets.ime",
      "notes": ""
    },
    {
      "match": "react-native-keyboard-aware-scroll-view",
      "category": "layout",
      "risk": "low",
      "ios": "Built-in keyboard avoidance",
      "android": "imePadding()",
      "notes": ""
    },
    {
      "match": "@reduxjs/toolkit",
      "category": "state",
      "risk": "medium",
      "ios": "@Observable view models + repositories",
      "android": "ViewModel + StateFlow + repositories",
      "notes": "Split the global store: server data -> repositories, UI state -> view models. RTK Query endpoints feed contracts/openapi"
    },
    {
      "match": "redux",
      "category": "state",
      "risk": "medium",
      "ios": "@Observable view models + repositories",
      "android": "ViewModel + StateFlow + repositories",
      "notes": "Reducers are a good source of business rules and test vectors"
    },
    {
      "match": "react-redux",
      "category": "state",
      "risk": "low",
      "ios": "n/a",
      "android": "n/a",
      "notes": ""
    },
    {
      "match": "redux-persist",
      "category": "storage",
      "risk": "high",
      "ios": "Read legacy blob in LegacyDataMigrator",
      "android": "Read legacy blob in LegacyDataMigrator",
      "notes": "Persisted JSON inside AsyncStorage/MMKV: list persisted slices in analysis/data-at-rest.md"
    },
    {
      "match": "zustand",
      "category": "state",
      "risk": "medium",
      "ios": "@Observable view models + repositories",
      "android": "ViewModel + StateFlow + repositories",
      "notes": "Check for persist() middleware: that is data at rest"
    },
    {
      "match": "mobx",
      "category": "state",
      "risk": "medium",
      "ios": "@Observable (closest mental model)",
      "android": "StateFlow / Compose state",
      "notes": ""
    },
    {
      "match": "mobx-state-tree",
      "category": "state",
      "risk": "medium",
      "ios": "@Observable + value models",
      "android": "StateFlow + data classes",
      "notes": "Snapshots may be persisted: check storage"
    },
    {
      "match": "jotai",
      "category": "state",
      "risk": "low",
      "ios": "@Observable",
      "android": "StateFlow",
      "notes": ""
    },
    {
      "match": "recoil",
      "category": "state",
      "risk": "low",
      "ios": "@Observable",
      "android": "StateFlow",
      "notes": ""
    },
    {
      "match": "@tanstack/react-query",
      "category": "server-state",
      "risk": "medium",
      "ios": "Repository with cache + async/await",
      "android": "Repository exposing Flow, Room/in-memory cache",
      "notes": "Record staleTime, retry, refetchOnFocus/Reconnect, optimistic updates in the spec: users notice these"
    },
    {
      "match": "react-query",
      "category": "server-state",
      "risk": "medium",
      "ios": "Repository with cache",
      "android": "Repository with Flow",
      "notes": "Legacy v3 package name"
    },
    {
      "match": "swr",
      "category": "server-state",
      "risk": "medium",
      "ios": "Repository with cache",
      "android": "Repository with Flow",
      "notes": ""
    },
    {
      "match": "@apollo/client",
      "category": "networking",
      "risk": "medium",
      "ios": "Apollo iOS",
      "android": "Apollo Kotlin",
      "notes": "Reuse .graphql operations and schema; normalized cache policies go in the spec"
    },
    {
      "match": "axios",
      "category": "networking",
      "risk": "medium",
      "ios": "URLSession + swift-openapi-generator client",
      "android": "Retrofit/OkHttp or Ktor + generated client",
      "notes": "Interceptors (auth, refresh, headers, retry) -> middleware / OkHttp Authenticator"
    },
    {
      "match": "@react-native-async-storage/async-storage",
      "category": "storage",
      "risk": "high",
      "ios": "UserDefaults (non-sensitive)",
      "android": "DataStore (Preferences)",
      "notes": "Legacy data must be migrated on first native launch. Storage format depends on the major version"
    },
    {
      "match": "react-native-mmkv",
      "category": "storage",
      "risk": "high",
      "ios": "MMKV iOS SDK (reads same files) or UserDefaults",
      "android": "MMKV Android SDK (reads same files) or DataStore",
      "notes": "Note instance IDs and encryption keys used"
    },
    {
      "match": "expo-secure-store",
      "category": "secure-storage",
      "risk": "high",
      "ios": "Keychain Services",
      "android": "Android Keystore (+ Tink)",
      "notes": "Session tokens usually live here. Port the library's decrypt logic for migration"
    },
    {
      "match": "react-native-keychain",
      "category": "secure-storage",
      "risk": "high",
      "ios": "Keychain Services",
      "android": "Android Keystore (+ Tink)",
